# --- Supabase (free tier project: https://supabase.com) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key - server-side only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# --- Shopify Admin API ---
# Custom app installed on the OldStar store (Settings > Apps > Develop apps)
SHOPIFY_STORE_DOMAIN=oldstar.myshopify.com
SHOPIFY_ADMIN_API_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-10

# --- Bosta API ---
BOSTA_API_BASE_URL=https://app.bosta.co/api/v2
BOSTA_API_KEY=

# --- Anthropic (Claude) API - used for AI photo review of return items ---
ANTHROPIC_API_KEY=

# --- Auth ---
# Single shared admin login for the OldStar team (private tool, no multi-tenant OAuth)
ADMIN_EMAIL=team@oldstar.com
ADMIN_PASSWORD=change-me
# Random 32+ char secret used to sign the admin session cookie
AUTH_SECRET=

# --- Cron protection ---
# Vercel Cron sends this as a Bearer token (Authorization header) - set the same
# value in the Vercel project's Cron Job settings / env vars.
CRON_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
