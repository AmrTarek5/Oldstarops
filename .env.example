# --- Supabase (free tier project: https://supabase.com) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key - server-side only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# --- Shopify Admin API ---
# Custom app created in Shopify's Dev Dashboard (Settings > Apps > Develop
# apps > Build apps in Dev Dashboard), installed on the OldStar store.
# Since Jan 2026 these apps don't expose a static access token - the app
# authenticates itself via the client credentials grant using these two
# values (see src/lib/shopify.ts). Find them under the app's Settings tab.
SHOPIFY_STORE_DOMAIN=oldstar.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2024-10

# --- Bosta API ---
# Get this from https://business.bosta.co/settings/api-integration. Sent as
# the raw Authorization header value - no "Bearer" prefix (confirmed with
# Bosta support; their own docs page mislabels this "Bearer Auth").
# If it's freshly generated and still returns errorCode 1028 "Invalid
# authorization token or API key", that's not a formatting problem - open a
# support ticket with Bosta, it means the key/account needs enabling on
# their side.
BOSTA_API_BASE_URL=https://app.bosta.co/api/v2
BOSTA_API_KEY=

# OldStar's own warehouse/pickup address, used as the pickup point when
# auto-creating a return/exchange delivery. BOSTA_WAREHOUSE_ZONE_ID and
# BOSTA_WAREHOUSE_DISTRICT_ID are Bosta's own internal location IDs (not
# plain text) - not yet resolved; leave blank until we find the right
# Bosta endpoint to look them up, and return pickups may fail to create
# without them.
BOSTA_WAREHOUSE_CITY=Cairo
BOSTA_WAREHOUSE_ADDRESS=
BOSTA_WAREHOUSE_ZONE_ID=
BOSTA_WAREHOUSE_DISTRICT_ID=

# --- Anthropic (Claude) API - used for AI photo review of return items ---
ANTHROPIC_API_KEY=

# --- Auth ---
# Single shared admin login for the OldStar team (private tool, no multi-tenant OAuth)
ADMIN_EMAIL=team@oldstar.com
ADMIN_PASSWORD=change-me
# Random 32+ char secret used to sign the admin session cookie
AUTH_SECRET=

# --- Cron protection ---
# Vercel Cron sends this as a Bearer token (Authorization header) - set the same
# value in the Vercel project's Cron Job settings / env vars.
CRON_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
